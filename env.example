# Vercel & Railway 환경 변수 예시
# 프로덕션 환경에서 필요한 경우에만 설정

# API Keys (필요시)
# VITE_API_KEY=your_api_key_here

# 환경 설정
# NODE_ENV=production

# 기능 플래그 (선택사항)
# VITE_ENABLE_ANALYTICS=false
# VITE_ENABLE_ERROR_TRACKING=false

# 외부 서비스 URL (필요시)
# VITE_API_BASE_URL=https://api.example.com

# Railway PostgreSQL 연결 정보
# Railway는 자동으로 DATABASE_URL 환경 변수를 제공합니다
# 백엔드 서비스에서만 필요합니다
# DATABASE_URL=postgresql://user:password@host:port/database

# 또는 개별 환경 변수로 설정 (개발 환경용)
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=postgres
# PGDATABASE=vibe_coding_navigator

# 백엔드 서버 설정
# PORT=8000
# CORS_ORIGIN=*

